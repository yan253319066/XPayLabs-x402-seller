# XPayLabs-x402-seller Configuration
#
# Copy this file to .env and fill in your values.

# Your EVM receiving wallet address (where USDC payments will be sent)
EVM_ADDRESS=0xYourEvmWalletAddress

# Facilitator URL (testnet: https://x402.org/facilitator, mainnet: https://api.cdp.coinbase.com/platform/v2/x402)
FACILITATOR_URL=https://x402.org/facilitator

# Port to listen on
PORT=4021

# Network CAIP-2 identifier (testnet: eip155:84532, mainnet: eip155:8453)
NETWORK=eip155:84532
